rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function token() {
      return request.auth.token;
    }

    function isAdmin() {
      return signedIn() && token().email == 'neuereatec@gmail.com';
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    function isDispatcher(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/dispatchers/$(request.auth.uid));
    }

    function isDriver(orgId, driverId) {
      return signedIn()
        && token().role == 'driver'
        && token().orgId == orgId
        && token().driverId == driverId;
    }

    function isOrgDriver(orgId) {
      return signedIn()
        && token().role == 'driver'
        && token().orgId == orgId;
    }

    function radioCreateKeysOk() {
      return request.resource.data.keys().hasOnly([
        'from', 'driverId', 'audioBase64', 'createdAt', 'contentType', 'durationMs',
        'lat', 'lng', 'audience', 'senderDriverId', 'senderDisplayName', 'groupId'
      ]);
    }

    function radioAudienceOk() {
      return !('audience' in request.resource.data)
        || request.resource.data.audience in ['direct', 'peer', 'group', 'all'];
    }

    function groupHasMember(orgId, groupId, memberId) {
      return memberId in get(/databases/$(database)/documents/orgs/$(orgId)/groups/$(groupId)).data.memberDriverIds;
    }

    function driverRadioCreateOk(orgId) {
      let d = request.resource.data;
      let me = token().driverId;
      let audience = 'audience' in d ? d.audience : 'direct';
      return d.from == 'driver'
        && radioClipPayloadOk()
        && radioAudienceOk()
        && (
          (audience == 'direct' && d.driverId == me)
          || (audience == 'peer'
            && d.senderDriverId == me
            && d.driverId != me
            && d.groupId is string
            && groupHasMember(orgId, d.groupId, me)
            && groupHasMember(orgId, d.groupId, d.driverId))
          || (audience == 'group'
            && d.senderDriverId == me
            && d.groupId is string
            && groupHasMember(orgId, d.groupId, me)
            && (d.driverId == me || groupHasMember(orgId, d.groupId, d.driverId)))
        );
    }

    function radioClipPayloadOk() {
      return request.resource.data.audioBase64 is string
        && request.resource.data.audioBase64.size() < 900000
        && request.resource.data.contentType is string
        && (!('durationMs' in request.resource.data)
          || (request.resource.data.durationMs is number
            && request.resource.data.durationMs >= 0
            && request.resource.data.durationMs < 120000))
        && (!('lat' in request.resource.data)
          || request.resource.data.lat == null
          || (request.resource.data.lat is number
            && request.resource.data.lat >= -90
            && request.resource.data.lat <= 90))
        && (!('lng' in request.resource.data)
          || request.resource.data.lng == null
          || (request.resource.data.lng is number
            && request.resource.data.lng >= -180
            && request.resource.data.lng <= 180));
    }

    function placeTypeOk() {
      return request.resource.data.type in ['home_base', 'checkpoint'];
    }

    match /orgs/{orgId} {
      allow read: if isDispatcher(orgId)
        || (signedIn() && token().role == 'driver' && token().orgId == orgId);
      allow write: if false;

      match /dispatchers/{uid} {
        allow read: if isDispatcher(orgId) || request.auth.uid == uid;
        allow write: if false;
      }

      match /drivers/{driverId} {
        allow read: if isDispatcher(orgId) || isOrgDriver(orgId);

        allow create, delete: if isDispatcher(orgId);

        allow update: if isDispatcher(orgId)
          || (isDriver(orgId, driverId)
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'onDuty',
                  'lastLat',
                  'lastLng',
                  'lastSpeed',
                  'lastHeading',
                  'lastTelemetryAt'
                ]));

        match /telemetry/{docId} {
          allow read: if isDispatcher(orgId);
          allow write: if false;
        }
      }

      match /pairCodes/{code} {
        allow read, write: if false;
      }

      match /contacts/{contactId} {
        allow read, write: if isDispatcher(orgId);
      }

      match /bookings/{bookingId} {
        allow read, write: if isDispatcher(orgId);
      }

      // Dispatcher→driver PTT request/response tracking (3 min window)
      match /radioRequests/{requestId} {
        allow read: if isDispatcher(orgId);
        allow create: if isDispatcher(orgId)
          && request.resource.data.keys().hasOnly([
            'kind', 'driverId', 'driverName', 'outboundClipId', 'replyClipId',
            'status', 'createdAt', 'expiresAt', 'respondedAt', 'broadcastBatchId', 'groupId'
          ])
          && request.resource.data.kind in ['direct', 'broadcast']
          && request.resource.data.status == 'pending'
          && request.resource.data.driverId is string
          && request.resource.data.driverName is string
          && request.resource.data.outboundClipId is string
          && request.resource.data.replyClipId == null
          && request.resource.data.respondedAt == null;
        allow update, delete: if false;
      }

      // Home bases + checkpoints (circular geofences)
      match /places/{placeId} {
        allow read: if isDispatcher(orgId) || isOrgDriver(orgId);
        allow create, update: if isDispatcher(orgId)
          && placeTypeOk()
          && request.resource.data.keys().hasAll(['type', 'name', 'lat', 'lng', 'radiusM'])
          && request.resource.data.name is string
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.radiusM is number
          && request.resource.data.radiusM > 0
          && request.resource.data.radiusM <= 50000;
        allow delete: if isDispatcher(orgId);
      }

      // Saved corridors (home → checkpoint)
      match /routes/{routeId} {
        allow read: if isDispatcher(orgId) || isOrgDriver(orgId);
        allow create, update, delete: if isDispatcher(orgId);
      }

      // Arrive / leave / dwell / off-route / speed alerts (written by Cloud Functions)
      match /fleetEvents/{eventId} {
        allow read: if isDispatcher(orgId);
        allow create, update: if false;
        allow delete: if isDispatcher(orgId);
      }

      // Per-driver presence / throttle state (Cloud Functions only)
      match /fleetState/{driverId} {
        allow read, write: if false;
      }

      match /groups/{groupId} {
        allow read: if isDispatcher(orgId) || isOrgDriver(orgId);
        allow create, update, delete: if isDispatcher(orgId);
      }

      // Live PTT + 7-day archive (base64 clips; Storage optional later)
      match /radio/{clipId} {
        allow read: if isDispatcher(orgId)
          || (isDriver(orgId, resource.data.driverId));

        allow create: if (isDispatcher(orgId)
          && request.resource.data.from == 'dispatch'
          && radioCreateKeysOk()
          && radioClipPayloadOk()
          && radioAudienceOk())
          || (signedIn()
            && token().role == 'driver'
            && token().orgId == orgId
            && driverRadioCreateOk(orgId)
            && radioCreateKeysOk());

        // Dispatcher may update/delete; drivers may only mark their inbox heard.
        allow update: if isDispatcher(orgId)
          || (isDriver(orgId, resource.data.driverId)
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(['driverHeardAt'])
            && request.resource.data.driverId == resource.data.driverId
            && request.resource.data.from == resource.data.from
            && request.resource.data.audioBase64 == resource.data.audioBase64
            && request.resource.data.contentType == resource.data.contentType);

        allow delete: if isDispatcher(orgId);
      }

      // Map DVR track points (7-day rolling; purged by scheduled function)
      match /tracks/{driverId}/points/{pointId} {
        allow read: if isDispatcher(orgId) || isDriver(orgId, driverId);

        // Drivers create breadcrumbs while on duty (t usually FieldValue.serverTimestamp()).
        // heading/speed may be omitted or null when GPS lacks bearing/speed.
        allow create: if isDriver(orgId, driverId)
          && request.resource.data.keys().hasOnly([
            't', 'lat', 'lng', 'speed', 'heading'
          ])
          && request.resource.data.keys().hasAll(['t', 'lat', 'lng'])
          && request.resource.data.t is timestamp
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.lat >= -90
          && request.resource.data.lat <= 90
          && request.resource.data.lng >= -180
          && request.resource.data.lng <= 180
          && (!('speed' in request.resource.data)
            || request.resource.data.speed == null
            || request.resource.data.speed is number)
          && (!('heading' in request.resource.data)
            || request.resource.data.heading == null
            || request.resource.data.heading is number);

        allow update, delete: if isDispatcher(orgId);
      }
    }
  }
}
