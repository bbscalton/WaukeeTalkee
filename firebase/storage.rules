rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isDispatcher(orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/orgs/$(orgId)/dispatchers/$(request.auth.uid));
    }

    function isDriver(orgId, driverId) {
      return signedIn()
        && request.auth.token.role == 'driver'
        && request.auth.token.orgId == orgId
        && request.auth.token.driverId == driverId;
    }

    // Radio clips: orgs/{orgId}/radio/{driverId}/{file}
    match /orgs/{orgId}/radio/{driverId}/{fileName} {
      allow read: if isDispatcher(orgId) || isDriver(orgId, driverId);

      allow write: if (isDispatcher(orgId) || isDriver(orgId, driverId))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Booking attachments: orgs/{orgId}/bookings/{bookingId}/{fileName}
    match /orgs/{orgId}/bookings/{bookingId}/{fileName} {
      allow read: if isDispatcher(orgId);
      allow write: if isDispatcher(orgId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}

