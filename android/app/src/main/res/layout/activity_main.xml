<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EEF2"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/pairPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waukee Talkee"
            android:textAllCaps="true"
            android:textColor="#0F6E56"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter pair code"
            android:textColor="#14212B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ask dispatch for your 6-character code."
            android:textColor="#5B6B76" />

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Pair code"
            android:inputType="textCapCharacters"
            android:maxLength="6" />

        <TextView
            android:id="@+id/pairError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9B1C1C"
            android:visibility="gone" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0F6E56"
            android:text="Connect"
            android:textColor="#F4FFFA" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow these to go on duty"
            android:textColor="#14212B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="- Precise location (required)\n- Microphone (talk back to dispatch)\n- Notifications (Android 13+)\n- Later: allow all-the-time location in system settings"
            android:textColor="#5B6B76" />

        <Button
            android:id="@+id/grantButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0F6E56"
            android:text="Grant permissions"
            android:textColor="#F4FFFA" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open app settings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signed in as"
            android:textColor="#5B6B76" />

        <TextView
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#14212B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dutyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#0F6E56"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/radioStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#14212B"
            android:padding="16dp"
            android:text="RADIO STANDBY\nHold Volume Up to talk to dispatch"
            android:textColor="#F4FFFA"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/dutyButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#0F6E56"
            android:text="Go on duty"
            android:textColor="#F4FFFA"
            android:textSize="18sp" />

        <Button
            android:id="@+id/unpairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Unpair this phone" />
    </LinearLayout>
</FrameLayout>
