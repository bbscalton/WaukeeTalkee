<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WaukeeTalkee" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/asphalt</item>
        <item name="android:navigationBarColor">@color/asphalt</item>
        <item name="android:windowBackground">@color/asphalt</item>
        <item name="android:colorPrimary">@color/amber</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="colorControlActivated">@color/amber</item>
        <item name="android:editTextColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Text.Brand" parent="TextAppearance.AppCompat.Large">
        <item name="android:fontFamily">@font/anton_regular</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Display" parent="TextAppearance.AppCompat.Display1">
        <item name="android:fontFamily">@font/anton_regular</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Btn.Amber" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_amber</item>
        <item name="android:textColor">@color/asphalt</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Btn.Ghost" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
